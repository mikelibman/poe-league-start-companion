{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoE League Start Companion",
  "version": "0.1.0",
  "identifier": "ca.arketek.poe-league-start",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PoE League Start Companion",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxQkNCNjFEQTY5QkM4NDUKUldSRnlKdW1IYmE4NGVadCtueVVpMmdBOER2aUN5L0dsc2xWOGlFSW94QzZ3MFR2d1Z0ZFVXMjQK",
      "endpoints": [
        "https://github.com/mikelibman/poe-league-start-companion/releases/latest/download/latest.json"
      ]
    }
  }
}
